# XQNEXT Framework 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ===========================================
# 基本配置
# ===========================================

# 环境类型：development, production
ENVIRONMENT=production

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===========================================
# 端口配置
# ===========================================

# WebUI 和 REST API 端口
API_PORT=8000

# OneBot WebSocket 端口
ONEBOT_PORT=8080

# ===========================================
# 安全配置
# ===========================================

# 密钥（用于 JWT token 签名，请务必修改！）
SECRET_KEY=change-this-to-a-random-secret-key

# WebUI 登录凭据
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=admin123

# ===========================================
# OneBot 配置
# ===========================================

# OneBot WebSocket 地址
ONEBOT_WS_URL=ws://host.docker.internal:3001

# OneBot 访问令牌（如果 OneBot 实现需要）
ONEBOT_ACCESS_TOKEN=your-token-here

# ===========================================
# AI 配置（可选）
# ===========================================

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI API Base URL（如果使用代理或第三方服务）
OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================
# 数据库配置（可选，用于 PostgreSQL）
# ===========================================

# POSTGRES_PASSWORD=your-secure-password

# ===========================================
# 其他配置
# ===========================================

# 时区
TZ=Asia/Shanghai

