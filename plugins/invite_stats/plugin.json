{
  "name": "invite_stats",
  "version": "1.0.0",
  "author": "XQNEXT",
  "description": "邀请统计机器人 - 统计群成员邀请人数，支持查询、排名和导出功能",
  "category": "management",
  "tags": ["invite", "stats", "group", "邀请统计", "排行榜"],
  "default_config": {
    "admin_qq": "3302727375",
    "enabled_groups": [],
    "smtp_host": "smtp.qq.com",
    "smtp_port": 587,
    "smtp_user": "",
    "smtp_password": "",
    "smtp_from": "",
    "smtp_to": ""
  },
  "config_schema": {
    "admin_qq": {
      "type": "string",
      "default": "3302727375",
      "description": "管理员QQ号（可以使用导出功能的用户）"
    },
    "enabled_groups": {
      "type": "array",
      "default": [],
      "description": "启用插件的群号列表（为空则所有群都启用）"
    },
    "smtp_host": {
      "type": "string",
      "default": "smtp.qq.com",
      "description": "SMTP服务器地址"
    },
    "smtp_port": {
      "type": "number",
      "default": 587,
      "description": "SMTP服务器端口（587为TLS，465为SSL）"
    },
    "smtp_user": {
      "type": "string",
      "default": "",
      "description": "SMTP用户名（邮箱地址）"
    },
    "smtp_password": {
      "type": "string",
      "default": "",
      "description": "SMTP密码（QQ邮箱使用授权码）"
    },
    "smtp_from": {
      "type": "string",
      "default": "",
      "description": "发件人邮箱地址"
    },
    "smtp_to": {
      "type": "string",
      "default": "",
      "description": "收件人邮箱地址（导出统计将发送到此邮箱）"
    }
  }
}

