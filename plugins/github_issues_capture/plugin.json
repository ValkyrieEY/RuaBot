{
  "name": "github_issues_capture",
  "version": "1.0.0",
  "author": "XQNEXT",
  "description": "GitHub Issues 和 Commits 卡片渲染插件，支持获取指定编号或最新的 issue/commit 并渲染为美观卡片",
  "entry": "main.py",
  "dependencies": [
    {
      "name": "requests",
      "version": ">=2.31.0",
      "required": true
    },
    {
      "name": "pillow",
      "version": ">=10.3.0",
      "required": true
    }
  ],
  "config_schema": {
    "owner": {
      "type": "string",
      "default": "ValkyrieEY",
      "description": "GitHub 仓库所有者"
    },
    "repo": {
      "type": "string",
      "default": "RuaBot",
      "description": "GitHub 仓库名称"
    },
    "github_token": {
      "type": "string",
      "default": "",
      "description": "GitHub API Token（可选，从环境变量 GITHUB_TOKEN 获取）"
    }
  },
  "default_config": {
    "owner": "ValkyrieEY",
    "repo": "RuaBot",
    "github_token": ""
  }
}

