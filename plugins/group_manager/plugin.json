{
  "name": "group_manager",
  "version": "1.0.0",
  "author": "XQNEXT",
  "description": "小依群管 - 功能强大的QQ群管理插件，支持授权管理、入群验证、违禁检测、问答系统等20+功能模块",
  "category": "管理",
  "tags": ["群管", "管理", "验证", "黑名单", "问答"],
  "priority": 20,
  "default_config": {
    "owner_qq": "",
    "admin_qq_list": []
  },
  "config_schema": {
    "owner_qq": {
      "type": "string",
      "default": "",
      "description": "主人QQ号（拥有最高权限），例如：123456789"
    },
    "admin_qq_list": {
      "type": "array",
      "default": [],
      "description": "管理员QQ号列表，例如：[\"111111111\", \"222222222\"]",
      "items": {
        "type": "string"
      }
    }
  }
}

